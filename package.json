{
  "name": "photostudio-manager",
  "version": "2.0.3",
  "private": true,
  "license": "0BSD",
  "description": "PhotoStudio Manager monorepo: shared web SPA + Electron (Windows) + Capacitor (Android) shells.",
  "workspaces": [
    "web application",
    "Windows application",
    "Android Mobile"
  ],
  "overrides": {
    "@electron/get": "^5.1.0",
    "image-size": "^2.0.4"
  },
  "scripts": {
    "start": "npm run start -w \"web application\"",
    "web": "npm run web -w \"web application\"",
    "dev:web": "npm run dev:web -w \"web application\"",
    "build": "npm run export:web",
    "build:web": "npm run export:web",
    "export:web": "npm run export:web -w \"web application\"",
    "lint": "npm run lint -w \"web application\"",
    "typecheck": "npm run typecheck -w \"web application\"",
    "android:sync": "npm run sync -w \"Android Mobile\"",
    "android:build": "npm run build -w \"Android Mobile\"",
    "desktop:build": "npm run build -w \"Windows application\"",
    "desktop:build:x64": "npm run build:x64 -w \"Windows application\"",
    "desktop:build:x86": "npm run build:x86 -w \"Windows application\""
  }
}
