{
  "name": "photostudio-manager",
  "version": "2.1.0",
  "private": true,
  "license": "0BSD",
  "description": "PhotoStudio Manager monorepo: shared app (core) + Electron (Windows) + Capacitor (Android) shells.",
  "workspaces": [
    "core",
    "Windows application",
    "Android Mobile"
  ],
  "overrides": {
    "@electron/get": "^5.1.0",
    "image-size": "^2.0.4"
  },
  "scripts": {
    "start": "npm run start -w core",
    "dev": "npm run dev -w core",
    "build": "npm run build -w core",
    "lint": "npm run lint -w core",
    "typecheck": "npm run typecheck -w core",
    "android:sync": "npm run sync -w \"Android Mobile\"",
    "android:build": "npm run build -w \"Android Mobile\"",
    "desktop:build": "npm run build -w \"Windows application\"",
    "desktop:build:x64": "npm run build:x64 -w \"Windows application\"",
    "desktop:build:x86": "npm run build:x86 -w \"Windows application\""
  }
}
