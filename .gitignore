# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
/Android Mobile/android/keystore.properties
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/Android Mobile/android

# desktop (Electron) app
/Windows application/dist/
/Windows application/dist-windows/
/Windows application/node_modules/
/Windows application/out/
/Windows application/*.log

# release APK artifacts (kept locally in test_APK/, shipped via GitHub releases)
/test_APK/

# internal agent memory files (kept locally, never committed to git)
/AGENTS.md
/AGENTS_PLAN.md

# stray folders (housekeeping)
/scripts/

# local Capacitor plugin gradle outputs (regenerated by cap sync + gradle)
/Android Mobile/capacitor-plugin-psm-install/android/build/
/Android Mobile/capacitor-plugin-psm-install/android/.gradle/
