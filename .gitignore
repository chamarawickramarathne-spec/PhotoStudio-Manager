# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
/Android Mobile/android/keystore.properties
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios

# Android (Capacitor) build outputs — the source project is tracked so release
# config (manifest, signing, R8 rules, file paths) survives regeneration.
/Android Mobile/android/.gradle/
/Android Mobile/android/.idea/
/Android Mobile/android/build/
/Android Mobile/android/app/build/
/Android Mobile/android/.cxx/
/Android Mobile/android/captures/
/Android Mobile/android/local.properties

# desktop (Electron) app
/Windows application/dist/
/Windows application/dist-windows/
/Windows application/dist-preview/
/Windows application/node_modules/
/Windows application/out/
/Windows application/*.log

# local APK artifacts (kept for sideload testing; never shipped via GitHub releases)
/test_APK/

# Play Store AAB artifacts (kept locally, uploaded to Play Console)
/release_aab/

# internal agent memory files (kept locally, never committed to git)
/AGENTS.md
/AGENTS_PLAN.md

# stray folders (housekeeping)
/scripts/
